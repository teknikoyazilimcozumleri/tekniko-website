---
import tekniko_white from '../assets/tekniko_white.svg';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-navy/95 backdrop-blur-xl border-b border-ice/10">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-20">
        <a class="flex items-center -ml-8" href="/">
            <img src={tekniko_white.src} alt="Tekniko Yazılım Çözümleri" class="h-35 w-auto brightness-0 invert transition-all duration-300 hover:drop-shadow-[0_0_10px_#00E5FF]" />
        </a>
        <nav class="flex items -center gap-4 relative">
            <div class="relative group">
                <a href="/en" class="text-ice text-sm font-normal tracking-wide py-2 transition-colors duration-200 hover:text-cyber" aria-label="Switch to English">
                    <span class="text-lg align-middle">🇬🇧</span>
                </a>
            </div>
            <input id="menu-toggle" type="checkbox" class="hidden peer" />
            <label for="menu-toggle" class="lg:hidden cursor-pointer text-ice p-2" aria-label="Toggle navigation menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </label>
            <div class="hidden lg:flex gap-10">
                <div class="relative group">
                    <a href="/#about" class="text-ice text-sm font-normal tracking-wide py-2 transition-colors duration-200 hover:text-cyber">Hakkımızda</a>
                </div>
                <div class="relative group">
                    <a href="/#services" class="text-ice text-sm font-normal tracking-wide py-2 transition-colors duration-200 hover:text-cyber">Hizmetlerimiz</a>
                </div>
                <div class="relative group">
                    <a href="/blog" class="text-ice text-sm font-normal tracking-wide py-2 transition-colors duration-200 hover:text-cyber">Blog</a>
                </div>
                <div class="relative group">
                    <a href="/career" class="text-ice text-sm font-normal tracking-wide py-2 transition-colors duration-200 hover:text-cyber">Kariyer</a>
                </div>
                <div class="relative group">
                    <a href="/#contact" class="text-ice text-sm font-normal tracking-wide py-2 transition-colors duration-200 hover:text-cyber">İletişim</a>
                </div>
            </div>
            <div class="absolute right-0 top-full mt-2 w-56 bg-navy/95 border border-ice/10 rounded shadow-lg hidden peer-checked:block lg:hidden">
                <a href="/#about" class="block px-4 py-3 text-ice text-sm tracking-wide transition-colors duration-200 hover:text-cyber">Hakkımızda</a>
                <a href="/#services" class="block px-4 py-3 text-ice text-sm tracking-wide transition-colors duration-200 hover:text-cyber">Hizmetlerimiz</a>
                <a href="/blog" class="block px-4 py-3 text-ice text-sm tracking-wide transition-colors duration-200 hover:text-cyber">Blog</a>
                <a href="/career" class="block px-4 py-3 text-ice text-sm tracking-wide transition-colors duration-200 hover:text-cyber">Kariyer</a>
                <a href="/#contact" class="block px-4 py-3 text-ice text-sm tracking-wide transition-colors duration-200 hover:text-cyber">İletişim</a>
            </div>
        </nav>
    </div>
</header>
---
import Layout from '../layouts/Layout.astro';
import teknikohero from '../assets/teknikohero.svg';
import teknikoinsurance from '../assets/teknikoinsurance.png';
import teknikodashboards from '../assets/teknikodashboards.png';
---

<Layout>
	<!-- Hero Section -->
	<section id="hero" class="relative overflow-hidden bg-slate text-ice">
		<div class="pointer-events-none absolute inset-0 bg-[linear-gradient(148deg,#243444_0%,#3c5162_36%,#4A5D6E_64%,#8b9faf_100%)]" aria-hidden="true"></div>
		<div class="pointer-events-none absolute right-[4%] top-[64%] h-[28rem] w-[34rem] -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(248,250,252,0.22)_0%,rgba(16,185,129,0.12)_42%,transparent_72%)]" aria-hidden="true"></div>
		<div class="relative mx-auto w-full max-w-[96rem] px-6 py-14 sm:px-10 lg:px-32 lg:py-36">
			<div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:gap-6">
				<div class="w-full min-w-0 lg:flex-1">
					<h1 class="font-serif text-5xl font-bold tracking-tight leading-[1.05] lg:text-5xl">FinTech ve InsurTech için yazılım</h1>
					<p class="mt-6 max-w-md text-base leading-relaxed text-ice/75">Underwriting otomasyonu, otonom ERP hatları ve finansal veri sistemleri. Sigortacılar, fintech’ler ve finans ekipleri için.</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-mint px-6 py-3 text-sm font-semibold text-navy transition-all duration-300 hover:brightness-110">Teknik Görüşme <span aria-hidden="true">→</span></a>
						<a href="/#services" class="inline-flex items-center rounded-full border border-ice/40 px-6 py-3 text-sm font-semibold text-ice transition-all duration-300 hover:border-ice">Hizmetlerimiz</a>
					</div>
					<ul class="m-0 mt-12 flex list-none flex-col gap-5 p-0 sm:flex-row sm:items-center">
						<li class="flex items-center gap-3">
							<svg class="h-5 w-5 shrink-0 text-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 14l2 2 4-4"></path></svg>
							<span class="text-sm leading-snug text-ice/90">Underwriting<br>Otomasyonu</span>
						</li>
						<li class="hidden h-8 w-px bg-ice/25 sm:block" aria-hidden="true"></li>
						<li class="flex items-center gap-3">
							<svg class="h-5 w-5 shrink-0 text-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h6v4H4zM14 13h6v4h-6zM10 9h2a3 3 0 010 6h-2"></path></svg>
							<span class="text-sm leading-snug text-ice/90">Otonom ERP<br>Hatları</span>
						</li>
						<li class="hidden h-8 w-px bg-ice/25 sm:block" aria-hidden="true"></li>
						<li class="flex items-center gap-3">
							<svg class="h-5 w-5 shrink-0 text-ice" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19V5M4 19h16M8 15l3-4 3 2 5-7"></path></svg>
							<span class="text-sm leading-snug text-ice/90">Finansal Yapay<br>Zeka</span>
						</li>
					</ul>
				</div>
				<div class="w-full shrink-0 lg:w-[min(40rem,48%)] lg:translate-x-6 lg:translate-y-7">
					<img src={teknikohero.src} alt="Poliçe dosyaları, faturalar ve hasar kayıtlarının doğrulanmış bir finans defterine aktarımı" class="block h-auto w-full" />
				</div>
			</div>
		</div>
	</section>

	<!-- About div -->
	<div id="about">
		<section id="engineering" class="py-32">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
					<div>
						<h2 class="font-serif text-4xl font-bold mb-6 tracking-tight leading-tight">Finans ve sigortanın içinde çalışan mühendislik</h2>
						<p class="text-lg mb-8 text-slate leading-relaxed">
							Tekniko Yazılım Çözümleri, sigorta şirketleri, fintech’ler ve finans ekipleri için yazılım üretir.
							Underwriting kararlarını otomatikleştirir, kapanış ve mutabakatı otonom ERP hatlarına bağlar.
							Fiyatlama, risk ve raporlama için finansal yapay zeka ile veri altyapısını kurar.
						</p>
					</div>
					<div class="relative">
						<img src={teknikoinsurance.src} alt="Tekniko Yazılım Çözümleri InsurTech çözümleri" class="w-full h-96 object-cover rounded-4xl" />
					</div>
				</div>
			</div>
		</section>

		<!-- Customer Experience -->
		<section class="py-32">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
					<div class="lg:order-2">
						<h2 class="font-serif text-4xl font-bold mb-6 tracking-tight leading-tight">Operasyonunuzun ritmine göre</h2>
						<p class="text-lg mb-8 text-slate leading-relaxed">
							Poliçe verisi, başvuru dosyaları, mutabakat ve finans kapanışı etrafında tasarlarız.
							Ekibinizin riski nasıl fiyatladığını, parayı nasıl hareket ettirdiğini ve bunu nasıl raporladığını esas alırız.
							Ardından bu süreçleri her gün ayakta tutan yazılımı teslim ederiz.
						</p>
					</div>
					<div class="relative">
						<img src={teknikodashboards.src} alt="Finans ve sigorta operasyonları için yazılım" class="w-full h-96 object-cover rounded-lg" />
					</div>
				</div>
			</div>
		</section>
	</div>
	<div id="services" class="bg-navy">
		<section class="pt-36 pb-8 text-center">
			<div class="max-w-7xl mx-auto px-6">
				<h2 class="font-serif text-4xl md:text-5xl text-ice font-bold mb-4 tracking-tight">FinTech ve InsurTech sistemleri, uçtan uca</h2>
				<p class="text-lg mb-4 text-ice/75 leading-relaxed max-w-4xl mx-auto">Underwriting otomasyonu, otonom ERP hatları, finansal yapay zeka ve veri mühendisliği. Ve bunların etrafındaki üretim yazılımı.</p>
			</div>
		</section>

		<!-- Services Cards -->
		<section class="pb-32">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<div class="text-center p-6 rounded-lg">
						<div class="w-16 h-16 bg-slate rounded-lg flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5a2 2 0 012-2h2a2 2 0 012 2v0a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 14l2 2 4-4"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-4 text-ice">InsurTech Underwriting Otomasyonu</h3>
						<p class="text-medium text-ice/75 leading-relaxed">Başvuru, risk skorlama ve karar adımlarını otomatikleştiririz. Underwriter’lar zamanlarını istisnalara ayırır. Başvuru, poliçe verisi ve karar arasındaki iş akışlarını, modelleri ve entegrasyonları kurarız.</p>
					</div>
					<div class="text-center p-6 rounded-lg">
						<div class="w-16 h-16 bg-slate rounded-lg flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h6v4H4zM14 13h6v4h-6z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 9h2a3 3 0 010 6h-2"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-4 text-ice">Otonom ERP Hatları</h3>
						<p class="text-medium text-ice/75 leading-relaxed">Kapanış, mutabakat ve operasyonel veri, her adımı birinin itmesi gerekmeden akar. Kayıt sistemlerinizden veri çeken, finans ekibinizin kurallarını uygulayan ve kayıtları ERP’nin beklediği yere bırakan hatlar tasarlarız.</p>
					</div>
					<div class="text-center p-6 rounded-lg">
						<div class="w-16 h-16 bg-slate rounded-lg flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19V5M4 19h16"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 15l3-4 3 2 5-7"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-4 text-ice">Finansal Yapay Zeka ve Veri Mühendisliği</h3>
						<p class="text-medium text-ice/75 leading-relaxed">Modeller, altındaki finansal veri kadar iyidir. Fiyatlama, risk, suistimal ve raporlama için veri hatları, özellikler ve yapay zeka sistemleri kurarız. Finans ve uyum ekiplerinin beklediği izlenebilirlikle.</p>
					</div>
					<div class="text-center p-6 rounded-lg">
						<div class="w-16 h-16 bg-slate rounded-lg flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-4 text-ice">FinTech ve InsurTech Yazılımı</h3>
						<p class="text-medium text-ice/75 leading-relaxed">Bu sistemlerin etrafındaki platformlar da üretime çıkar: API’ler, iç araçlar, çekirdek sigorta ve finans sistemleriyle entegrasyonlar ve operasyon ekiplerinin her gün kullandığı arayüzler. Aynı alan bilgisiyle geliştiririz.</p>
					</div>

				</div>
			</div>
		</section>
	</div>
	<!-- Contact Form Section -->
	<section id="contact" class="pt-36">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-16">
				<h2 class="font-serif text-5xl font-bold mb-8 tracking-tight">İletişim</h2>
				<p class="text-lg mb-8 text-slate leading-relaxed max-w-4xl mx-auto">Underwriting, ERP veya finansal veride hâlâ elle yürüyen bir süreç varsa yazın. Kapsamı birlikte netleştiririz.</p>
			</div>
			
			<div class="max-w-4xl mx-auto">
				<form class="space-y-4" action="https://api.web3forms.com/submit" method="POST" id="form">
					    <!-- Your Access key here. Don't worry this can be public -->
						<input type="hidden" name="access_key" value="63935025-60ac-487b-8967-09aa7520c119">

						<!-- Optional: Can be type="hidden" or type="text" for subject -->
						<input type="hidden" name="subject" value="New Tekniko Website Submission">

						<!-- Optional: From Name you want to see in the email
							Default is "Notifications". you can overwrite here -->
						<input type="hidden" name="from_name" value="Notifications">

						<!-- Optional: Redirect URL after form submission -->
						<input type="hidden" name="redirect" value="www.teknikoyazilimcozumleri.com">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
						<div>
							<label for="name" class="block text-sm font-medium text-slate mb-2">Ad Soyad *</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required 
								class="w-full px-4 py-3 bg-white border border-slate/40 text-navy rounded-lg focus:ring-2 focus:ring-cyber focus:border-transparent transition-all duration-200"
								placeholder="Adınız ve soyadınız"
							/>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-slate mb-2">E-posta *</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required 
								class="w-full px-4 py-3 bg-white border border-slate/40 text-navy rounded-lg focus:ring-2 focus:ring-cyber focus:border-transparent transition-all duration-200"
								placeholder="ornek@email.com"
							/>
						</div>
					</div>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
						<div>
							<label for="company" class="block text-sm font-medium text-slate mb-2">Şirket</label>
							<input 
								type="text" 
								id="company" 
								name="company" 
								class="w-full px-4 py-3 bg-white border border-slate/40 text-navy rounded-lg focus:ring-2 focus:ring-cyber focus:border-transparent transition-all duration-200"
								placeholder="Şirket adınız"
							/>
						</div>
						<div>
							<label for="phone" class="block text-sm font-medium text-slate mb-2">Telefon</label>
							<input 
								type="tel" 
								id="phone" 
								name="phone" 
								class="w-full px-4 py-3 bg-white border border-slate/40 text-navy rounded-lg focus:ring-2 focus:ring-cyber focus:border-transparent transition-all duration-200"
								placeholder="+90 5XX XXX XX XX"
							/>
						</div>
					</div>
					
					<div>
						<label for="service" class="block text-sm font-medium text-slate mb-2">Hizmet Türü</label>
						<select 
							id="service" 
							name="service" 
							class="w-full px-4 py-3 bg-white border border-slate/40 text-navy rounded-lg focus:ring-2 focus:ring-cyber focus:border-transparent transition-all duration-200"
						>
							<option value="">Hizmet türünü seçin</option>
							<option value="underwriting-automation">InsurTech Underwriting Otomasyonu</option>
							<option value="erp-pipelines">Otonom ERP Hatları</option>
							<option value="financial-ai-data">Finansal Yapay Zeka ve Veri Mühendisliği</option>
							<option value="fintech-insurtech-software">FinTech ve InsurTech Yazılımı</option>
							<option value="other">Diğer</option>
						</select>
					</div>
					
					<div>
						<label for="message" class="block text-sm font-medium text-slate mb-2">Mesaj *</label>
						<textarea 
							id="message" 
							name="message" 
							rows="6" 
							required 
							class="w-full px-4 py-3 bg-white border border-slate/40 text-navy rounded-lg focus:ring-2 focus:ring-cyber focus:border-transparent transition-all duration-200 resize-none"
							placeholder="Underwriting, ERP veya finansal veri sürecinizi kısaca anlatın..."
						></textarea>
					</div>
					
					<div class="text-center">
						<button 
							type="submit" 
							class="inline-block px-12 py-4 bg-cyber text-navy font-semibold text-sm tracking-widest uppercase rounded-lg transition-all duration-300 hover:bg-cyber-hover hover:-translate-y-0.5 focus:ring-2 focus:ring-cyber focus:ring-offset-2"
						>
							Mesaj Gönder
						</button>
					</div>
				</form>
			</div>
		</div>
	</section>
</Layout>
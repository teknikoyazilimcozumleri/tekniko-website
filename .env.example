# --- GENERAL DJANGO SETTINGS ---
DEBUG=False
# Use a strong secret key in production
SECRET_KEY=replace-with-strong-secret
# Hostnames allowed to access the application
ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted origins for CSRF (include scheme + port)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://localhost,https://127.0.0.1
# Allowed frontend origins for cross-origin API calls (React dev/prod)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
# Base URL for email links (password reset, etc.)
BASE_URL=http://localhost:8000
# Set True when HTTPS is terminated by reverse proxy/load balancer
USE_X_FORWARDED_PROTO=True
# Common name for the auto-generated self-signed cert in nginx container
SSL_CERT_DOMAIN=localhost
# Host ports for nginx reverse proxy
NGINX_HTTP_PORT=8000

# --- DATABASE CONNECTION ---
# Full connection string for dj-database-url
DATABASE_URL=postgres://postgres:postgres@db:5432/django_template
# Internal variables for entrypoint and container checks
DATABASE=postgres
SQL_HOST=db
SQL_PORT=5432

# --- POSTGRES CONTAINER CONFIG ---
POSTGRES_DB=django_template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- DJANGO-ALLAUTH / SITES ---
# Default Django sites framework ID used by django-allauth
SITE_ID=1

# --- SOCIAL LOGIN PROVIDERS (OPTIONAL) ---
# Google OAuth client credentials for django-allauth
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# --- IYZICO PAYMENT (Checkout Form) ---
# Get keys from Iyzico merchant panel. Sandbox: sandbox-merchant.iyzipay.com
# Use sandbox for testing (test cards); production: api.iyzico.com and real keys
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sadece host. Sandbox: sandbox-api.iyzipay.com (curl ile erişilebilir)
IYZICO_BASE_URL=sandbox-api.iyzipay.com
# Callback URL base: Iyzico ödeme sonrası kullanıcıyı bu adrese yönlendirir (dış dünyadan erişilebilir).
# Ngrok: ngrok http 8000 çalıştır, çıkan adresi aşağıya yaz (sonda / olmasın).
NGROK_PUBLIC_URL=
# Veya doğrudan: PAYMENT_CALLBACK_HOST=https://yourdomain.com
#PAYMENT_CALLBACK_HOST=
# Abonelik webhook imza doğrulaması için (isteğe bağlı; Merchant panelden alınır)
#IYZICO_MERCHANT_ID=

# --- INITIAL SUPERUSER CREDENTIALS ---
# Automatically created by entrypoint.sh on first run
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123